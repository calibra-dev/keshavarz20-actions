{
  "schema_version": "product-primary-route-lock-v1",
  "primary_producer": "connected_chatgpt_queue",
  "primary_flow": [
    "Connected ChatGPT live research",
    "product-engine/queue/*.json",
    ".github/workflows/k20-product-queue-publisher.yml",
    "K20 Bridge 3.3",
    "WooCommerce/WordPress",
    "readback",
    "Lighthouse x3",
    "keep_or_rollback",
    "checkpoint"
  ],
  "automatic_api_generation_forbidden": true,
  "api_fallback": {
    "workflow": ".github/workflows/k20-product-autopilot.yml",
    "manual_only": true,
    "allowed_trigger": "workflow_dispatch"
  },
  "invariants": {
    "concurrency": 1,
    "max_products_per_run": 1,
    "immutable_queue": true,
    "protected_commerce_fields": true,
    "fail_closed": true,
    "inherited_platform_debt_is_warning": true
  },
  "forbidden_primary_dependencies": [
    "OPENAI_API_KEY",
    "product-engine/ai_runtime.py"
  ],
  "canonical_prompt": "product-engine/SCHEDULED_TASK_PROMPT.md",
  "canonical_config": "product-engine/config.json",
  "queue_delivery": {
    "primary": "direct_main_immutable_queue",
    "primary_transport": "github_contents_api",
    "atomic_fallback": "github_git_data_api",
    "atomic_fallback_steps": [
      "read_current_main",
      "verify_queue_absent",
      "create_blob",
      "create_tree_from_current_main",
      "create_commit_with_current_main_parent",
      "recheck_main_head",
      "update_main_ref_fast_forward_only"
    ],
    "branch_fallback": "automation/product-*",
    "branch_transport": "github_git_data_api",
    "promoter_workflow": ".github/workflows/k20-product-queue-promoter.yml",
    "publisher_workflow": ".github/workflows/k20-product-queue-publisher.yml",
    "promoter_handoff": "explicit_workflow_dispatch",
    "publisher_dispatch_endpoint": "actions/workflows/k20-product-queue-publisher.yml/dispatches",
    "never_rely_on_github_token_push_recursion": true,
    "never_rewrite_existing_queue": true,
    "fresh_live_read_required_before_each_delivery_attempt": true,
    "cursor_must_not_advance_on_transport_block": true,
    "automation_must_remain_enabled_on_transport_block": true,
    "ingress_workflow": ".github/workflows/k20-product-queue-ingress.yml",
    "ingress_request_path": "product-engine/queue-ingress-ops/*.json",
    "ingress_schema": "product-queue-ingress-v1",
    "ingress_payload_source": "immutable_git_blob_sha",
    "ingress_use": "preferred_when_connected_contents_write_rejects_large_queue",
    "ingress_requires_bound_fresh_live_read": true,
    "ingress_validates_queue_contract": true,
    "ingress_dispatches_publisher_explicitly": true
  },
  "producer_live_read": {
    "workflow": ".github/workflows/k20-product-producer-live-read.yml",
    "request_path": "product-engine/live-read-ops/*.json",
    "request_schema": "product-producer-live-read-v1",
    "result_path": "product-engine/live-read-results/*.json",
    "result_schema": "product-producer-live-read-result-v1",
    "bridge_transport": "K20 Bridge 3.3",
    "product_action": "rest.proxy",
    "product_method": "GET",
    "product_path_template": "/wc/v3/products/<PRODUCT_ID>",
    "seo_action": "seo.read",
    "required_freshness_field": "product.result.data_date_modified_gmt",
    "require_exact_product_id": true,
    "require_publish_status": true,
    "direct_wordpress_credentials_forbidden": true,
    "connected_producer_must_not_write_bridge_v3_ops": true,
    "branch_fallback": "automation/product-*",
    "promoter_workflow": ".github/workflows/k20-product-live-read-promoter.yml",
    "promoter_handoff": "explicit_workflow_dispatch",
    "dispatch_endpoint": "actions/workflows/k20-product-producer-live-read.yml/dispatches",
    "never_rely_on_github_token_push_recursion": true
  },
  "platform_debt_policy": {
    "absolute_targets_remain_visible": true,
    "inherited_baseline_failures_are_warnings": true,
    "new_post_publish_failures_remain_blocking": true,
    "measurement_unavailable_remains_blocking": true,
    "regressions_still_rollback": true
  }
}
