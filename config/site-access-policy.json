{
  "version": 1,
  "primary_execution": "wpvibe-abilities",
  "secondary_execution": "keshavarz20-on-site-bridge",
  "cloud_execution": "github-hosted-actions",
  "allowed_scopes": [
    "products.read",
    "products.create_draft",
    "products.update_content",
    "products.update_identity",
    "products.update_stock",
    "products.update_taxonomies",
    "products.update_media",
    "products.update_seo",
    "posts.read",
    "posts.create_draft",
    "posts.update",
    "posts.update_seo",
    "pages.read",
    "pages.create_draft",
    "pages.update",
    "pages.update_seo",
    "media.read",
    "media.upload_from_url",
    "media.update_metadata",
    "taxonomies.read",
    "taxonomies.create",
    "taxonomies.update",
    "menus.read",
    "menus.create",
    "menus.update_items",
    "comments.read",
    "comments.create",
    "comments.update",
    "frontend.audit",
    "internal_links.audit",
    "cache.purge",
    "bridge.health",
    "performance.litespeed_vpi"
  ],
  "blocked_scopes": [
    "users",
    "roles",
    "capabilities",
    "plugins",
    "themes",
    "wordpress_core",
    "admin_settings",
    "woocommerce_settings",
    "payments",
    "shipping_configuration",
    "tax_configuration",
    "orders",
    "customers",
    "coupons",
    "discounts",
    "prices",
    "secrets",
    "tokens",
    "api_keys",
    "passwords"
  ],
  "forbidden_payload_keys": [
    "price",
    "regular_price",
    "sale_price",
    "date_on_sale_from",
    "date_on_sale_to",
    "discount",
    "discount_type",
    "coupon",
    "coupon_code",
    "payment_method",
    "payment_method_title",
    "shipping_method",
    "tax_status",
    "tax_class",
    "password",
    "application_password",
    "token",
    "secret",
    "api_key",
    "consumer_key",
    "consumer_secret",
    "role",
    "roles",
    "capability",
    "capabilities"
  ],
  "rules": {
    "product_creation_status": "draft",
    "delete_exposed_to_chat": false,
    "price_mutation": false,
    "discount_mutation": false,
    "admin_control_plane": false,
    "prefer_plugin_ability_over_raw_database": true,
    "prefer_direct_private_connector_for_unpublished_content": true,
    "never_commit_credentials": true,
    "never_commit_private_draft_content_to_public_repo": true,
    "narrow_admin_setting_exceptions": {
      "litespeed.conf.media-vpi": {
        "scope": "performance.litespeed_vpi",
        "mode": "exact_toggle",
        "required_existing": "0",
        "allowed_target": "1",
        "rollback": "0",
        "precondition": {
          "quic_cloud_linked": true,
          "free_page_optimization_remaining_daily_quota_min": 1,
          "paid_page_optimization_balance_required": 0
        },
        "purpose": "Wave1 VPI activation for verified above-the-fold LCP remediation only"
      }
    }
  }
}
