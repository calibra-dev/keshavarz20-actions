    "old_content": "<script>\n(function(){\n const endpoint='/wp-json/wc/store/v1/products';\n let selected=[];\n const strip=s=>{const d=document.createElement('div');d.innerHTML=s||'';return d.textContent||''};\n const esc=s=>String(s??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m]));\n async function search(){\n  const q=document.getElementById('k20-search').value.trim();\n  if(!q)return;\n  const box=document.getElementById('k20-search-results'); box.textContent='در حال جست‌وجو...';\n  try{\n   const r=await fetch(endpoint+'?per_page=12&search='+encodeURIComponent(q),{credentials:'same-origin'});\n   if(!r.ok)throw new Error('HTTP '+r.status);\n   const rows=await r.json();\n   box.innerHTML=rows.length?rows.map(p=>'<button type=\"button\" data-id=\"'+p.id+'\" style=\"display:block;width:100%;text-align:right;padding:9px;margin:5px 0\">'+esc(p.name)+'</button>').join(''):'محصولی پیدا نشد.';\n   box.querySelectorAll('button[data-id]').forEach(b=>b.onclick=()=>add(rows.find(x=>String(x.id)===b.dataset.id)));\n  }catch(e){box.textContent='دریافت فهرست محصولات ممکن نشد. صفحه را دوباره بارگذاری کنید.'}\n }\n function add(p){\n  if(!p||selected.some(x=>x.id===p.id))return;\n  if(selected.length>=4){alert('حداکثر ۴ محصول قابل مقایسه است.');return;}\n  selected.push(p);render();\n }\n function remove(id){selected=selected.filter(x=>x.id!==id);render()}\n function price(p){return strip(p.price_html||'')||'اعلام نشده'}\n function stock(p){return p.is_in_stock===true?'موجود':(p.is_in_stock===false?'ناموجود':'اعلام نشده')}\n function attrs(p){const a=p.attributes||[];if(!a.length)return 'اعلام نشده';return '<ul>'+a.map(x=>'<li><strong>'+esc(x.name)+':</strong> '+esc((x.terms||[]).map(t=>t.name).join('، ')||'اعلام نشده')+'</li>').join('')+'</ul>'}\n function render(){\n  document.getElementById('k20-selected').innerHTML=selected.length?selected.map(p=>'<span style=\"display:inline-block;border:1px solid #ccc;border-radius:999px;padding:6px 10px;margin:4px\">'+esc(p.name)+' <button type=\"button\" data-remove=\"'+p.id+'\" aria-label=\"حذف '+esc(p.name)+'\">×</button></span>').join(''):'هنوز محصولی انتخاب نشده است.';\n  document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>remove(Number(b.dataset.remove)));\n  if(selected.length<2){document.getElementById('k20-compare').innerHTML='<p>حداقل دو محصول انتخاب کنید.</p>';return;}\n  const cols=selected.map(p=>'<th style=\"padding:10px;border:1px solid #ddd;min-width:180px\">'+(p.images&&p.images[0]?'<img src=\"'+esc(p.images[0].thumbnail||p.images[0].src)+'\" alt=\"\" style=\"max-width:100px;height:auto;display:block;margin:auto\">':'')+'<a href=\"'+esc(p.permalink)+'\">'+esc(p.name)+'</a></th>').join('');\n  const row=(label,fn)=>'<tr><th style=\"text-align:right;padding:9px;border:1px solid #ddd\">'+label+'</th>'+selected.map(p=>'<td style=\"vertical-align:top;padding:9px;border:1px solid #ddd\">'+fn(p)+'</td>').join('')+'</tr>';\n  document.getElementById('k20-compare').innerHTML='<div style=\"overflow:auto\"><table style=\"border-collapse:collapse;width:100%\"><thead><tr><th></th>'+cols+'</tr></thead><tbody>'+\n   row('قیمت',p=>esc(price(p)))+row('موجودی',p=>esc(stock(p)))+row('ویژگی‌های ثبت‌شده',p=>attrs(p))+\n   '</tbody></table></div>';\n }\n document.getElementById('k20-search-btn').onclick=search;\n document.getElementById('k20-search').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();search();}});\n render();\n})();\n</script>",
    "new_content": "<script>(function(){const endpoint='/wp-json/wc/store/v1/products';let selected=[];const strip=s=>{const d=document.createElement('div');d.innerHTML=s||'';return d.textContent||''},esc=s=>String(s??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m]));async function search(){const q=document.getElementById('k20-search').value.trim();if(!q)return;const box=document.getElementById('k20-search-results');box.textContent='در حال جست‌وجو...';try{const r=await fetch(endpoint+'?per_page=12&search='+encodeURIComponent(q),{credentials:'same-origin'});if(!r.ok)throw new Error('HTTP '+r.status);const rows=await r.json();box.innerHTML=rows.length?rows.map(p=>'<button type=\"button\" data-id=\"'+p.id+'\" style=\"display:block;width:100%;text-align:right;padding:9px;margin:5px 0\">'+esc(p.name)+'</button>').join(''):'محصولی پیدا نشد.';box.querySelectorAll('button[data-id]').forEach(b=>b.onclick=()=>add(rows.find(x=>String(x.id)===b.dataset.id)));}catch(e){box.textContent='دریافت فهرست محصولات ممکن نشد. صفحه را دوباره بارگذاری کنید.';}}function add(p){if(!p||selected.some(x=>x.id===p.id))return;if(selected.length>=4){alert('حداکثر ۴ محصول قابل مقایسه است.');return;}selected.push(p);render();}function remove(id){selected=selected.filter(x=>x.id!==id);render();}function price(p){return strip(p.price_html||'')||'اعلام نشده';}function stock(p){return p.is_in_stock===true?'موجود':(p.is_in_stock===false?'ناموجود':'اعلام نشده');}function attrs(p){const a=p.attributes||[];if(!a.length)return 'اعلام نشده';return '<ul>'+a.map(x=>'<li><strong>'+esc(x.name)+':</strong> '+esc((x.terms||[]).map(t=>t.name).join('، ')||'اعلام نشده')+'</li>').join('')+'</ul>';}function render(){document.getElementById('k20-selected').innerHTML=selected.length?selected.map(p=>'<span style=\"display:inline-block;border:1px solid #ccc;border-radius:999px;padding:6px 10px;margin:4px\">'+esc(p.name)+' <button type=\"button\" data-remove=\"'+p.id+'\" aria-label=\"حذف '+esc(p.name)+'\">×</button></span>').join(''):'هنوز محصولی انتخاب نشده است.';document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>remove(Number(b.dataset.remove)));if(selected.length<2){document.getElementById('k20-compare').innerHTML='<p>حداقل دو محصول انتخاب کنید.</p>';return;}const cols=selected.map(p=>'<th style=\"padding:10px;border:1px solid #ddd;min-width:180px\">'+(p.images&&p.images[0]?'<img src=\"'+esc(p.images[0].thumbnail||p.images[0].src)+'\" alt=\"\" style=\"max-width:100px;height:auto;display:block;margin:auto\">':'')+'<a href=\"'+esc(p.permalink)+'\">'+esc(p.name)+'</a></th>').join(''),row=(label,fn)=>'<tr><th style=\"text-align:right;padding:9px;border:1px solid #ddd\">'+label+'</th>'+selected.map(p=>'<td style=\"vertical-align:top;padding:9px;border:1px solid #ddd\">'+fn(p)+'</td>').join('')+'</tr>';document.getElementById('k20-compare').innerHTML='<div style=\"overflow:auto\"><table style=\"border-collapse:collapse;width:100%\"><thead><tr><th></th>'+cols+'</tr></thead><tbody>'+row('قیمت',p=>esc(price(p)))+row('موجودی',p=>esc(stock(p)))+row('ویژگی‌های ثبت‌شده',p=>attrs(p))+'</tbody></table></div>';}document.getElementById('k20-search-btn').onclick=search;document.getElementById('k20-search').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();search();}});render();})();</script>",
