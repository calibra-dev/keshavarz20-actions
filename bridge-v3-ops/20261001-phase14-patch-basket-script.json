    "old_content": "<script>\n(function(){\n const n=id=>Number(document.getElementById(id).value);\n const fmt=x=>new Intl.NumberFormat('fa-IR',{maximumFractionDigits:1}).format(x);\n const out=document.getElementById('k20-result');\n const quote=document.getElementById('k20-quote');\n function calc(){\n  const area=n('k20-area'), len=n('k20-row-length'), spacing=n('k20-row-spacing'), roll=n('k20-roll-length'), waste=n('k20-waste'), spare=n('k20-spare');\n  if(!(area>0&&len>0&&spacing>0&&roll>0&&waste>=0&&spare>=0)){\n    out.innerHTML='<p role=\"alert\">ورودی‌ها را با عدد معتبر تکمیل کنید.</p>'; return;\n  }\n  const width=area/len;\n  const rows=Math.max(1,Math.floor(width/spacing));\n  const base=rows*len;\n  const total=base*(1+waste/100);\n  const rolls=Math.ceil(total/roll);\n  const starts=rows, ends=rows, spares=Math.ceil(rows*spare/100);\n  out.innerHTML='<div style=\"background:#eef7fb;border:1px solid #cfe3ed;border-radius:16px;padding:18px\"><h2 style=\"margin-top:0\">برآورد اولیه سبد</h2><table style=\"width:100%;border-collapse:collapse\"><tbody>'+\n   '<tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">عرض معادل زمین</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(width)+' متر</td></tr>'+\n   '<tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">تعداد ردیف برآوردی</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(rows)+'</td></tr>'+\n   '<tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">متراژ پایه نوار</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(base)+' متر</td></tr>'+\n   '<tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">متراژ با رزرو</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(total)+' متر</td></tr>'+\n   '<tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">تعداد رول</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(rolls)+'</td></tr>'+\n   '<tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">شیر/رابط شروع</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(starts)+' + '+fmt(spares)+' ذخیره</td></tr>'+\n   '<tr><th style=\"text-align:right;padding:9px\">قطعه انتهایی</th><td style=\"padding:9px\">'+fmt(ends)+' + '+fmt(spares)+' ذخیره</td></tr>'+\n   '</tbody></table><p><strong>نیازمند تأیید فنی:</strong> فیلتر، خط اصلی، فشار، دبی، کیفیت آب و سازگاری اتصال‌ها.</p></div>';\n  const msg='سلام. برای بررسی سبد آبیاری و پیش‌فاکتور راهنمایی می‌خواهم.\\n'+\n   'مساحت قابل کشت: '+area+' مترمربع\\nطول ردیف: '+len+' متر\\nفاصله ردیف: '+spacing+' متر\\n'+\n   'تعداد ردیف برآوردی: '+rows+'\\nمتراژ نوار با رزرو: '+Math.round(total*10)/10+' متر\\nتعداد رول: '+rolls+'\\n'+\n   'اتصال شروع: '+starts+' + '+spares+' ذخیره\\nانتهای خط: '+ends+' + '+spares+' ذخیره\\n'+\n   'لطفاً فیلتر، خط اصلی، فشار/دبی و سازگاری اتصالات را قبل از پیش‌فاکتور بررسی کنید.';\n  quote.href='https://wa.me/989179197005?text='+encodeURIComponent(msg);\n }\n document.getElementById('k20-calc').addEventListener('click',calc);\n calc();\n})();\n</script>",
    "new_content": "<script>(function(){const n=id=>Number(document.getElementById(id).value),fmt=x=>new Intl.NumberFormat('fa-IR',{maximumFractionDigits:1}).format(x),out=document.getElementById('k20-result'),quote=document.getElementById('k20-quote');function calc(){const area=n('k20-area'),len=n('k20-row-length'),spacing=n('k20-row-spacing'),roll=n('k20-roll-length'),waste=n('k20-waste'),spare=n('k20-spare');if(!(area>0&&len>0&&spacing>0&&roll>0&&waste>=0&&spare>=0)){out.innerHTML='<p role=\"alert\">ورودی‌ها را با عدد معتبر تکمیل کنید.</p>';return;}const width=area/len,rows=Math.max(1,Math.floor(width/spacing)),base=rows*len,total=base*(1+waste/100),rolls=Math.ceil(total/roll),starts=rows,ends=rows,spares=Math.ceil(rows*spare/100);out.innerHTML='<div style=\"background:#eef7fb;border:1px solid #cfe3ed;border-radius:16px;padding:18px\"><h2 style=\"margin-top:0\">برآورد اولیه سبد</h2><table style=\"width:100%;border-collapse:collapse\"><tbody><tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">عرض معادل زمین</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(width)+' متر</td></tr><tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">تعداد ردیف برآوردی</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(rows)+'</td></tr><tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">متراژ پایه نوار</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(base)+' متر</td></tr><tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">متراژ با رزرو</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(total)+' متر</td></tr><tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">تعداد رول</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(rolls)+'</td></tr><tr><th style=\"text-align:right;padding:9px;border-bottom:1px solid #ddd\">شیر/رابط شروع</th><td style=\"padding:9px;border-bottom:1px solid #ddd\">'+fmt(starts)+' + '+fmt(spares)+' ذخیره</td></tr><tr><th style=\"text-align:right;padding:9px\">قطعه انتهایی</th><td style=\"padding:9px\">'+fmt(ends)+' + '+fmt(spares)+' ذخیره</td></tr></tbody></table><p><strong>نیازمند تأیید فنی:</strong> فیلتر، خط اصلی، فشار، دبی، کیفیت آب و سازگاری اتصال‌ها.</p></div>';const msg='سلام. برای بررسی سبد آبیاری و پیش‌فاکتور راهنمایی می‌خواهم.\\nمساحت قابل کشت: '+area+' مترمربع\\nطول ردیف: '+len+' متر\\nفاصله ردیف: '+spacing+' متر\\nتعداد ردیف برآوردی: '+rows+'\\nمتراژ نوار با رزرو: '+Math.round(total*10)/10+' متر\\nتعداد رول: '+rolls+'\\nاتصال شروع: '+starts+' + '+spares+' ذخیره\\nانتهای خط: '+ends+' + '+spares+' ذخیره\\nلطفاً فیلتر، خط اصلی، فشار/دبی و سازگاری اتصالات را قبل از پیش‌فاکتور بررسی کنید.';quote.href='https://wa.me/989179197005?text='+encodeURIComponent(msg);}document.getElementById('k20-calc').addEventListener('click',calc);calc();})();</script>",
