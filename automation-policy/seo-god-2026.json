{
  "policy_version": "seo-god-2026.09.19-routing-fix",
  "brand": {
    "fa": "کشاورز بیست",
    "latin": "Keshavarz20",
    "mission": "کمک به کشاورز برای جلوگیری از انتخاب اشتباه، انتخاب سازگار، محاسبه بهتر و خرید کامل‌تر قبل از سفارش"
  },
  "hard_rules": [
    "people_first_not_ai_bait",
    "no_fake_reviews_or_customer_identity",
    "no_fake_author_or_reviewer",
    "no_invented_product_specs_prices_stock_field_tests_or_claims",
    "no_publish_without_human_review_for_generated_editorial_content",
    "no_fake_freshness",
    "no_scaled_thin_content",
    "no_keyword_stuffing",
    "no_llms_txt_as_ranking_hack",
    "dedupe_before_generation_and_before_wordpress_write",
    "preserve_draft_or_hold_safety_state"
  ],
  "research": {
    "discovery_is_not_evidence": true,
    "live_verification_required": true,
    "minimum_independent_domains": {
      "news": 2,
      "article": 2
    },
    "preferred_source_tiers": [
      {
        "tier": 1,
        "types": [
          "official_government_or_regulator",
          "university_or_extension",
          "peer_reviewed_research",
          "primary_dataset_or_standard",
          "manufacturer_primary_datasheet_for_its_own_product"
        ]
      },
      {
        "tier": 2,
        "types": [
          "reputable_news_wire",
          "recognized_agriculture_publication",
          "recognized_industry_body"
        ]
      },
      {
        "tier": 3,
        "types": [
          "secondary_analysis_with_clear_sources"
        ]
      }
    ],
    "rules": [
      "use_search_or_rss_for_discovery_but_cite_direct_sources_when_available",
      "cross_check_material_claims",
      "record_uncertainty_when_sources_disagree_or_evidence_is_incomplete",
      "prefer_current_sources_for_mutable_facts",
      "separate_fact_from_editorial_analysis"
    ]
  },
  "farmer_decision_lenses": [
    "profitability_and_total_cost",
    "input_cost_and_waste_risk",
    "water_efficiency_and_water_quality",
    "climate_and_seasonal_risk",
    "compatibility_and_wrong_purchase_risk",
    "installation_operation_and_maintenance",
    "evidence_confidence_and_limitations",
    "logistics_availability_and_support"
  ],
  "question_engine": {
    "goal": "generate transparent high-value pre-purchase and troubleshooting questions, never fake buyer testimony",
    "priority_intents": [
      "suitability",
      "compatibility",
      "selection",
      "design_scenario",
      "installation",
      "troubleshooting",
      "maintenance",
      "total_cost",
      "water_efficiency",
      "risk_check"
    ],
    "requirements": [
      "reference_the_actual_selected_product_or_family_context",
      "ask_for_missing_context_instead_of_assuming_specs",
      "prefer_decision_changing_questions_over_generic_questions",
      "avoid_repeating_existing_product_questions_and_answers",
      "preserve_polite_and_colloquial_distribution_targets"
    ]
  },
  "content_engine": {
    "answer_first": true,
    "human_first": true,
    "faq": {
      "mode": "adaptive",
      "minimum_when_used": 3,
      "maximum": 8,
      "never_force_for_every_topic": true
    },
    "required_decision_value": [
      "who_or_what_is_affected",
      "why_it_matters",
      "practical_action_or_decision",
      "limitations_or_uncertainty",
      "evidence_and_sources"
    ],
    "preferred_original_value": [
      "real_measurement",
      "real_field_observation",
      "real_product_evidence",
      "calculator_or_comparison",
      "expert_review_with_real_identity"
    ]
  },
  "news_engine": {
    "lookback_hours_default": 24,
    "draft_only": true,
    "required_story_properties": [
      "fresh",
      "material_to_farmers",
      "independently_verifiable",
      "not_duplicate",
      "not_rumor",
      "not_advertorial"
    ],
    "required_analysis": [
      "what_happened",
      "what_is_confirmed",
      "what_is_uncertain",
      "farmer_impact",
      "practical_next_step_if_any",
      "source_list"
    ]
  },
  "article_engine": {
    "draft_only": true,
    "target_words": {
      "minimum": 1200,
      "maximum": 2600
    },
    "requirements": [
      "topic_novelty_check",
      "search_intent_check",
      "farmer_decision_value",
      "three_or_more_credible_sources_when_available",
      "two_or_more_independent_domains",
      "internal_link_relevance",
      "adaptive_faq_only_when_useful",
      "clear_update_triggers"
    ]
  },
  "automation": {
    "question_status": "hold",
    "news_status": "draft",
    "article_status": "draft",
    "separate_engines": true,
    "separate_locks": true,
    "separate_logs": true,
    "kill_switch_required": true,
    "rollback_required": true,
    "no_secret_values_in_logs": true,
    "routing": {
      "news": {
        "queue_prefix": "daily-agri-news/queue/",
        "wordpress_post_type": "news",
        "required_content_type": "news",
        "taxonomy_category": "news_cat",
        "taxonomy_tag": "news_tag"
      },
      "article": {
        "queue_prefix": "daily-agri-articles/queue/",
        "wordpress_post_type": "post",
        "required_content_type": "post",
        "taxonomy_category": "category",
        "taxonomy_tag": "post_tag"
      },
      "hard_guards": [
        "news_payload_must_never_be_written_as_post",
        "article_payload_must_never_be_written_as_news",
        "publisher_must_verify_wordpress_post_type_after_write",
        "breaking_or_time_sensitive_news_belongs_to_news_engine_not_article_engine"
      ]
    }
  }
}
