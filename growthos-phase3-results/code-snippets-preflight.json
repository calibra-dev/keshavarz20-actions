        "items": {
          "type": "string"
        }
      },
      "scope": {
        "description": "زمینه‌ای (Context) که قطعه کد در آن قابل اجرا است.",
        "type": "string"
      },
      "condition_id": {
        "description": "شناسه‌ی وضعیت مرتبط با این قطعه کد.",
        "type": "integer"
      },
      "active": {
        "description": "وضعیت فعال‌سازی قطعه کد.",
        "type": "boolean"
      },
      "trashed": {
        "description": "اینکه آیا اسنیپت به عنوان حذف‌شده علامت‌گذاری شده است یا خیر.",
        "type": "boolean"
      },
      "locked": {
        "description": "اینکه آیا اسنیپت در برابر تغییر یا حذف قفل شده است یا خیر.",
        "type": "boolean"
      },
      "priority": {
        "description": "اولویت نسبی که قطعه کد در آن اجرا می‌شود.",
        "type": "integer"
      },
      "network": {
        "description": "آیا قطعه کد مربوط به کل شبکه است یا فقط مخصوص سایت.",
        "type": [
          "boolean",
          "null"
        ],
        "default": null
      },
      "shared_network": {
        "description": "اگر یک قطعه کد شبکه است، آیا می‌تواند به جای اجرا در کل شبکه، در سایت‌های مجزا فعال شود.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "modified": {
        "description": "تاریخ و زمان آخرین تغییر قطعه کد، در فرمت ISO.",
        "type": "string",
        "format": "date-time",
        "readonly": true
      },
      "last_active": {
        "description": "برچسب زمانی آخرین باری که اسنیپت فعال بوده است، در صورت وجود.",
        "type": "integer",
        "readonly": true
      },
      "code_error": {
        "description": "پیام خطا در صورتی که کد قطعه کد قابل تجزیه نباشد.",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": [
            "string",
            "integer"
          ]
        },
        "readonly": true
      },
      "code_error_trace": {
        "description": "ردپای پشته برای تازه‌ترین خطای کد اسنیپت.",
        "type": [
          "string",
          "null"
        ],
        "readonly": true
      }
    }
