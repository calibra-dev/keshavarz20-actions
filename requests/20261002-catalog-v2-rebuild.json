V2 .k20-card-tools button{width:28px;height:28px}\n#k20CatalogV2 .k20-filter-panel{display:block;position:fixed;z-index:1000004;left:0;right:auto;top:0;width:min(86vw,350px);height:100vh;border-radius:0;transform:translateX(-110%);padding:26px 20px;transition:.25s;overflow:auto}#k20CatalogV2 .k20-filter-panel.open{transform:translateX(0)}#k20CatalogV2 .k20-mobile-filter-backdrop{position:fixed;inset:0;z-index:1000003;background:rgba(7,33,19,.45);backdrop-filter:blur(3px)}#k20CatalogV2 .k20-mobile-filter-backdrop.open{display:block}#k20CatalogV2 .k20-compare-panel,#k20CatalogV2 .k20-product-panel,#k20CatalogV2 .k20-spec-panel{display:none}#k20CatalogV2 .k20-stage-pager{display:none}\n#k20CatalogV2 .k20-bottom-nav{display:flex;width:100%;overflow-x:auto;gap:8px;padding:12px 9px;min-height:100px;scrollbar-width:none}#k20CatalogV2 .k20-bottom-nav::-webkit-scrollbar{display:none}#k20CatalogV2 .k20-bottom-nav button,#k20CatalogV2 .k20-bottom-nav a{min-width:105px}#k20CatalogV2 .k20-bottom-nav span{height:44px}}\n@media(max-width:410px){#k20CatalogV2 .k20-hero h1{font-size:27px}#k20CatalogV2 .k20-feature-menu{grid-template-columns:repeat(3,1fr)}#k20CatalogV2 .k20-category-strip{grid-template-columns:repeat(2,1fr)}#k20CatalogV2 .k20-product-source ul.products li.product img{width:96px!important;height:100px!important}}\n</style>\n\n<script>\n(function(){\n'use strict';\nvar root=document.getElementById('k20CatalogV2');if(!root||root.dataset.ready==='1')return;root.dataset.ready='1';\nvar source=document.getElementById('k20ProductSource'),topSearch=document.getElementById('k20TopSearch'),sideSearch=document.getElementById('k20SideSearch'),miniSearch=document.getElementById('k20MiniSearch'),stockOnly=document.getElementById('k20StockOnly'),priceRange=document.getElementById('k20PriceRange'),priceLabel=document.getElementById('k20PriceLabel'),sortSelect=document.getElementById('k20SortSelect'),noResults=document.getElementById('k20NoResults'),filterPanel=document.getElementById('k20FilterPanel'),filterBackdrop=document.getElementById('k20FilterBackdrop'),toast=document.getElementById('k20Toast');\nvar compare=[],activeKeyword='',products=[],maxPrice=0,initialOrder=[];\nfunction txt(el){return el?(el.textContent||'').replace(/\\s+/g,' ').trim():''}\nfunction normalize(s){return(s||'').replace(/[ي]/g,'ی').replace(/[ك]/g,'ک').replace(/\\u200c/g,' ').replace(/\\s+/g,' ').trim().toLowerCase()}\nfunction toLatinDigits(s){var p='۰۱۲۳۴۵۶۷۸۹';return(s||'').replace(/[۰-۹]/g,function(d){return String(p.indexOf(d))}).replace(/[٬,]/g,'')}\nfunction getPrice(li){var a=li.querySelectorAll('.price .amount,.price bdi'),raw=a.length?txt(a[a.length-1]):txt(li.querySelector('.price')),n=parseInt(toLatinDigits(raw).replace(/[^0-9]/g,''),10);return isNaN(n)?0:n}\nfunction getTitle(li){return txt(li.querySelector('.woocommerce-loop-product__title'))||txt(li.querySelector('h2'))||txt(li)}\nfunction getLink(li){var a=li.querySelector('a.woocommerce-LoopProduct-link,a[href]');return a?a.href:'/shop/'}\nfunction getImage(li){var im=li.querySelector('img');return im?(im.currentSrc||im.src):''}\nfunction getPriceText(li){return txt(li.querySelector('.price'))||'قیمت را در صفحه محصول ببینید'}\nfunction isOut(li){return li.classList.contains('outofstock')||normalize(txt(li)).indexOf('ناموجود')>-1}\nfunction notify(m){toast.textContent=m;toast.classList.add('show');setTimeout(function(){toast.classList.remove('show')},1600)}\nfunction refreshProducts(){products=Array.prototype.slice.call(source.querySelectorAll('ul.products li.product'));initialOrder=products.slice();maxPrice=0;products.forEach(function(li,index){li.dataset.k20Index=String(index);var p=getPrice(li);if(p>maxPrice)maxPrice=p;if(!li.querySelector('.k20-card-tools')){var tools=document.createElement('div');tools.className='k20-card-tools';var fav=document.createElement('button');fav.type='button';fav.innerHTML='♡';fav.setAttribute('aria-label','علاقه مندی');var cmp=document.createElement('button');cmp.type='button';cmp.innerHTML='⚖';cmp.setAttribute('aria-label','افزودن به مقایسه');tools.appendChild(fav);tools.appendChild(cmp);li.appendChild(tools);fav.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();fav.classList.toggle('active');fav.innerHTML=fav.classList.contains('active')?'♥':'♡';notify('علاقه مندی به روز شد')});cmp.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();toggleCompare(li,cmp)})}li.addEventListener('mouseenter',function(){updateDetail(li)});li.addEventListener('click',function(e){if(e.target.closest('.k20-card-tools'))return;updateDetail(li)})});priceRange.max=String(maxPrice||100);priceRange.value=String(maxPrice||100);priceLabel.textContent=maxPrice?('تا '+maxPrice.toLocaleString('fa-IR')+' تومان'):'همه قیمت ها';if(products.length)updateDetail(products[0]);applyFilters()}\nfunction applyFilters(){var q=normalize(sideSearch.value||topSearch.value||miniSearch.value||''),cat=normalize(activeKeyword),only=stockOnly.checked,max=Number(priceRange.value||maxPrice||0),visible=0;products.forEach(function(li){var hay=normalize(getTitle(li)+' '+txt(li)),ok=(!q||hay.indexOf(q)>-1)&&(!cat||hay.indexOf(cat)>-1)&&(!only||!isOut(li))&&(!maxPrice||getPrice(li)===0||getPrice(li)<=max);li.style.display=ok?'':'none';if(ok)visible++});noResults.hidden=visible!==0}\nfunction sortProducts(){var ul=source.querySelector('ul.products');if(!ul)return;var arr=products.slice(),mode=sortSelect.value;if(mode==='name')arr.sort(function(a,b){return getTitle(a).localeCompare(getTitle(b),'fa')});if(mode==='price-asc')arr.sort(function(a,b){return getPrice(a)-getPrice(b)});if(mode==='price-desc')arr.sort(function(a,b){return getPrice(b)-getPrice(a)});if(mode==='default')arr=initialOrder.slice();arr.forEach(function(li){ul.appendChild(li)});products=arr;applyFilters()}\nfunction syncSearch(v){topSearch.value=v;sideSearch.value=v;miniSearch.value=v;applyFilters()}\nfunction updateDetail(li){var title=getTitle(li),price=getPriceText(li),link=getLink(li),image=getImage(li),stock=isOut(li)?'ناموجود':'موجود';document.getElementById('k20DetailTitle').textContent=title;document.getElementById('k20DetailPrice').textContent=price;var media=document.getElementById('k20DetailMedia');media.innerHTML=image?('<img src=\"'+image.replace(/\"/g,'&quot;')+'\" alt=\"'+title.replace(/\"/g,'&quot;')+'\">'):'<div class=\"k20-detail-placeholder\">بدون تصویر</div>';document.getElementById('k20DetailLink').href=link;document.getElementById('k20DetailActions').textContent=stock==='موجود'?'● موجود در فروشگاه':'● وضعیت موجودی را بررسی کنید';var rows=document.getElementById('k20SpecRows');rows.innerHTML='';[['نام محصول',title],['وضعیت',stock],['قیمت',price],['دسته بندی','اطلاعات صفحه محصول'],['اطلاعات کامل','مشاهده صفحه محصول']].forEach(function(row){var d=document.createElement('div'),s=document.createElement('span'),b=document.createElement('b');s.textContent=row[0];b.textContent=row[1];d.appendChild(s);d.appendChild(b);rows.appendChild(d)})}\nfunction toggleCompare(li,btn){var idx=compare.indexOf(li);if(idx>-1){compare.splice(idx,1);btn.classList.remove('active');notify('از مقایسه حذف شد')}else{if(compare.length>=2){notify('برای این نما حداکثر دو محصول انتخاب کنید');return}compare.push(li);btn.classList.add('active');notify('به مقایسه اضافه شد')}renderCompare()}\nfunction renderCompare(){var box=document.getElementById('k20CompareMini');if(!compare.length){box.innerHTML='<p>دو محصول را برای مقایسه انتخاب کنید.</p>';return}var html='';compare.forEach(function(li){html+='<div class=\"k20-compare-row\">'+(getImage(li)?'<img src=\"'+getImage(li).replace(/\"/g,'&quot;')+'\" alt=\"\">':'<span></span>')+'<b>'+getTitle(li)+'</b></div>'});if(compare.length===2)html+='<div class=\"k20-compare-checks\"><span>✓ قیمت</span><span>✓ موجودی</span><span>✓ مشخصات</span><span>✓ کاربرد</span></div>';box.innerHTML=html}\nfunction setCategory(keyword,button){activeKeyword=keyword||'';document.querySelectorAll('#k20CatalogV2 .k20-category-strip button').forEach(function(b){b.classList.remove('active')});if(button)button.classList.add('active');applyFilters()}\n[topSearch,sideSearch,miniSearch].forEach(function(input){input.addEventListener('input',function(){syncSearch(this.value)})});stockOnly.addEventListener('change',applyFilters);priceRange.addEventListener('input',function(){var v=Number(this.value||0);priceLabel.textContent=maxPrice?('تا '+v.toLocaleString('fa-IR')+' تومان'):'همه قیمت ها';applyFilters()});sortSelect.addEventListener('change',sortProducts);\ndocument.querySelectorAll('#k20CatalogV2 input[name=k20cat]').forEach(function(r){r.addEventListener('change',function(){setCategory(this.value,null)})});document.querySelectorAll('#k20CatalogV2 .k20-category-strip button').forEach(function(b){b.addEventListener('click',function(){setCategory(this.getAttribute('data-keyword')||'',this)})});\ndocument.getElementById('k20ClearFilters').addEventListener('click',function(){activeKeyword='';syncSearch('');stockOnly.checked=false;sortSelect.value='default';priceRange.value=String(maxPrice||100);priceLabel.textContent=maxPrice?('تا '+maxPrice.toLocaleString('fa-IR')+' تومان'):'همه قیمت ها';document.querySelectorAll('#k20CatalogV2 input[name=k20cat]').forEach(function(r){r.checked=r.value===''});document.querySelectorAll('#k20CatalogV2 .k20-category-strip button').forEach(function(b){b.classList.remove('active')});sortProducts()});document.getElementById('k20ResetView').addEventListener('click',function(){document.getElementById('k20ClearFilters').click()});document.getElementById('k20ShowProducts').addEventListener('click',function(){source.scrollIntoView({behavior:'smooth',block:'center'})});\nfunction openFilter(){filterPanel.classList.add('open');filterBackdrop.classList.add('open')}function closeFilter(){filterPanel.classList.remove('open');filterBackdrop.classList.remove('open')}document.getElementById('k20MobileFilter').addEventListener('click',openFilter);filterBackdrop.addEventListener('click',closeFilter);\ndocument.querySelectorAll('#k20CatalogV2 [data-focus]').forEach(function(b){b.addEventListener('click',function(){var t=this.getAttribute('data-focus');if(t==='search'){topSearch.focus()}else if(t==='compare'){document.getElementById('k20ComparePanel').scrollIntoView({behavior:'smooth',block:'center'})}else if(t==='specs'||t==='technical'){document.getElementById('k20SpecPanel').scrollIntoView({behavior:'smooth',block:'center'})}})});\ndocument.querySelectorAll('#k20CatalogV2 [data-nav]').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('#k20CatalogV2 [data-nav]').forEach(function(x){x.classList.remove('active')});this.classList.add('active');var n=this.getAttribute('data-nav');if(n==='filters'){if(window.innerWidth<=760)openFilter();else filterPanel.scrollIntoView({behavior:'smooth',block:'center'})}else if(n==='compare'){document.getElementById('k20ComparePanel').scrollIntoView({behavior:'smooth',block:'center'})}else if(n==='product'){document.getElementById('k20DetailPanel').scrollIntoView({behavior:'smooth',block:'center'})}else if(n==='technical'){document.getElementById('k20SpecPanel').scrollIntoView({behavior:'smooth',block:'center'})}else{document.getElementById('k20AppShell').scrollIntoView({behavior:'smooth',block:'center'})}})});\ndocument.getElementById('k20HeaderFav').addEventListener('click',function(){notify('علاقه مندی ها از کارت محصولات قابل مدیریت است')});\nfunction initWhenReady(){var count=source.querySelectorAll('ul.products li.product').length;if(count){refreshProducts();window.__K20CatalogV2={ready:true,productCount:products.length,applyFilters:applyFilters};return true}return false}\nif(!initWhenReady()){var observer=new MutationObserver(function(){if(initWhenReady())observer.disconnect()});observer.observe(source,{childList:true,subtree:true});setTimeout(function(){if(!window.__K20CatalogV2){window.__K20CatalogV2={ready:false,productCount:0}}},3500)}\n})();\n</script>"}}