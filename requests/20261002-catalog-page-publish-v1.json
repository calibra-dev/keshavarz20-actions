cursor:pointer}.k20-toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(25px);background:#123522;color:#fff;padding:11px 17px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;z-index:1000002;font-size:12px}.k20-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}\n@media(max-width:1100px){.k20-topbar{grid-template-columns:auto 1fr auto}.k20-topbar nav{display:none}.k20-search{grid-column:2}.k20-products{grid-template-columns:repeat(3,1fr)}.k20-catgrid{grid-template-columns:repeat(3,1fr)}}\n@media(max-width:760px){.k20-topbar{top:8px;width:calc(100% - 16px);margin-top:8px;height:auto;min-height:66px;padding:10px 12px;grid-template-columns:auto 1fr auto;gap:8px}.k20-brand b{font-size:14px}.k20-brand small{display:none}.k20-search{order:4;grid-column:1/-1;width:100%;height:42px}.k20-actions{gap:2px}.k20-actions a,.k20-actions button{width:30px}.k20-hero{min-height:430px;margin-top:-122px;padding-top:160px;border-radius:0 0 28px 28px}.k20-hero h1{font-size:34px}.k20-hero p{font-size:14px;line-height:1.8}.k20-feature-row{grid-template-columns:repeat(5,1fr);gap:4px;margin-top:26px}.k20-feature-row span{width:42px;height:42px}.k20-feature-row b{font-size:9px}.k20-catgrid{grid-template-columns:repeat(2,1fr)}main{width:calc(100% - 20px);padding-top:26px}.k20-workspace{display:block}.k20-filter{position:relative;top:auto;margin-bottom:16px}.k20-products{grid-template-columns:repeat(2,1fr);gap:9px}.k20-card-media{height:150px}.k20-card-body{padding:11px}.k20-card h3{font-size:12px;height:44px}.k20-card-actions{grid-template-columns:1fr 36px}.k20-detail{font-size:11px}.k20-compare-grid{grid-template-columns:1fr}.k20-section-head h2{font-size:21px}.k20-drawer-card{width:100%}.k20-detail-image{height:280px}}</style><script>(function(){\nconst S={page:1,per:12,all:[],compare:[]};\nconst q=s=>document.querySelector(s), qa=s=>Array.from(document.querySelectorAll(s));\nconst els={products:q('#k20Products'),loader:q('#k20Loader'),search:q('#k20Search'),side:q('#k20SideSearch'),stock:q('#k20Stock'),sort:q('#k20Sort'),more:q('#k20More'),drawer:q('#k20Drawer'),drawerBody:q('#k20DrawerBody'),compare:q('#k20CompareGrid'),empty:q('#k20CompareEmpty'),toast:q('#k20Toast')};\nconst money=p=>p&&p.prices?(Number(p.prices.price)/Math.pow(10,p.prices.currency_minor_unit||0)).toLocaleString('fa-IR')+' '+(p.prices.currency_symbol||'تومان'):'قیمت را مشاهده کنید';\nconst img=p=>p.images&&p.images[0]?p.images[0].src:'';\nfunction toast(t){els.toast.textContent=t;els.toast.classList.add('show');setTimeout(()=>els.toast.classList.remove('show'),1800)}\nfunction api(){const params=new URLSearchParams({per_page:S.per,page:S.page,orderby:els.sort.value||'menu_order'});const term=(els.side.value||els.search.value||'').trim();if(term)params.set('search',term);if(els.stock.checked)params.set('stock_status','instock');return '/wp-json/wc/store/v1/products?'+params.toString()}\nasync function load(reset=true){if(reset){S.page=1;S.all=[];els.products.innerHTML='';}els.loader.style.display='block';try{const r=await fetch(api(),{credentials:'same-origin'});if(!r.ok)throw new Error(r.status);const data=await r.json();S.all=reset?data:S.all.concat(data);render(S.all);els.more.style.display=data.length<S.per?'none':'block';}catch(e){els.loader.textContent='دریافت محصولات با خطا روبهرو شد. برای مشاهده همه محصولات وارد فروشگاه شوید.';els.loader.innerHTML+=' <a href=\"/shop/\" style=\"color:#0a7b3b;font-weight:800\">رفتن به فروشگاه ←</a>';}finally{if(S.all.length)els.loader.style.display='none'}}\nfunction card(p){const stock=p.is_in_stock!==false;return `<article class=\"k20-card\" data-id=\"${p.id}\"><div class=\"k20-card-media\">${img(p)?`<img loading=\"lazy\" src=\"${img(p)}\" alt=\"${p.name.replace(/\\\"/g,'&quot;')}\">`:''}<button class=\"k20-heart\">♡</button></div><div class=\"k20-card-body\"><div class=\"k20-card-meta\"><span class=\"k20-status ${stock?'':'out'}\">${stock?'موجود در فروشگاه':'ناموجود'}</span><small>${p.average_rating&&Number(p.average_rating)>0?'★ '+p.average_rating:''}</small></div><h3>${p.name}</h3><div class=\"k20-price\">${money(p)}</div><div class=\"k20-card-actions\"><button class=\"k20-detail\" data-detail=\"${p.id}\">مشاهده مشخصات</button><button class=\"k20-compare-btn\" data-compare=\"${p.id}\" title=\"افزودن به مقایسه\">⚖</button></div></div></article>`}\nfunction render(arr){els.products.innerHTML=arr.map(card).join('');bindCards()}\nfunction bindCards(){qa('[data-detail]').forEach(b=>b.onclick=()=>openDetail(Number(b.dataset.detail)));qa('[data-compare]').forEach(b=>b.onclick=()=>addCompare(Number(b.dataset.compare)));qa('.k20-heart').forEach(b=>b.onclick=()=>{b.textContent=b.textContent==='♡'?'♥':'♡';toast('علاقهمندی بهروزرسانی شد')})}\nfunction openDetail(id){const p=S.all.find(x=>x.id===id);if(!p)return;const cats=(p.categories||[]).map(x=>`<span class=\"k20-tag\">${x.name}</span>`).join('');const desc=(p.short_description||p.description||'').replace(/<[^>]+>/g,' ').slice(0,900);els.drawerBody.innerHTML=`<div class=\"k20-detail-image\">${img(p)?`<img src=\"${img(p)}\" alt=\"${p.name.replace(/\\\"/g,'&quot;')}\">`:''}</div><h2 class=\"k20-detail-title\">${p.name}</h2><div class=\"k20-detail-tags\">${cats}</div><p class=\"k20-detail-desc\">${desc||'برای بررسی مشخصات کامل، صفحه محصول را باز کنید.'}</p><div class=\"k20-price\">${money(p)}</div><div class=\"k20-buy\"><a href=\"${p.permalink||('/?p='+p.id)}\">صفحه کامل محصول ←</a><button data-dcompare=\"${p.id}\">⚖</button></div>`;els.drawer.classList.add('open');els.drawer.setAttribute('aria-hidden','false');const cb=q('[data-dcompare]');if(cb)cb.onclick=()=>addCompare(id)}\nfunction addCompare(id){const p=S.all.find(x=>x.id===id);if(!p)return;if(S.compare.some(x=>x.id===id)){toast('این محصول در مقایسه هست');return}if(S.compare.length>=3){toast('حداکثر ۳ محصول قابل مقایسه است');return}S.compare.push(p);renderCompare();toast('به مقایسه اضافه شد')}\nfunction renderCompare(){els.empty.style.display=S.compare.length?'none':'block';els.compare.innerHTML=S.compare.map(p=>`<div class=\"k20-compare-item\"><img src=\"${img(p)}\" alt=\"\"><h3>${p.name}</h3><div class=\"k20-price\">${money(p)}</div><div class=\"k20-compare-specs\"><div><span>وضعیت</span><b>${p.is_in_stock!==false?'موجود':'ناموجود'}</b></div><div><span>امتیاز</span><b>${p.average_rating||'—'}</b></div><div><span>دسته</span><b>${p.categories&&p.categories[0]?p.categories[0].name:'—'}</b></div></div><button class=\"k20-more\" data-remove=\"${p.id}\">حذف</button></div>`).join('');qa('[data-remove]').forEach(b=>b.onclick=()=>{S.compare=S.compare.filter(x=>x.id!==Number(b.dataset.remove));renderCompare()})}\nlet t;function debounce(fn){clearTimeout(t);t=setTimeout(fn,420)}\nels.search.addEventListener('input',()=>{els.side.value=els.search.value;debounce(()=>load(true))});els.side.addEventListener('input',()=>{els.search.value=els.side.value;debounce(()=>load(true))});els.stock.onchange=()=>load(true);els.sort.onchange=()=>load(true);els.more.onclick=()=>{S.page++;load(false)};q('#k20Clear').onclick=()=>{els.search.value='';els.side.value='';els.stock.checked=false;els.sort.value='menu_order';load(true)};q('#k20ResetCompare').onclick=()=>{S.compare=[];renderCompare()};q('#k20DrawerClose').onclick=()=>els.drawer.classList.remove('open');els.drawer.onclick=e=>{if(e.target===els.drawer)els.drawer.classList.remove('open')};qa('[data-scroll]').forEach(b=>b.onclick=()=>q('#'+b.dataset.scroll).scrollIntoView({behavior:'smooth'}));qa('[data-cat]').forEach(b=>b.onclick=()=>{els.side.value=b.querySelector('b').textContent;els.search.value=els.side.value;load(true);q('#products').scrollIntoView({behavior:'smooth'})});load(true);renderCompare();\n})();</script>"}}